// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Notification {
  id        String         @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean        @default(false)
  metadata  Json?          
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id])
  userId    String
}

enum NotificationType {
  NEW_SUBSCRIBER
  NEW_TIP
  VIDEO_PURCHASED
  COMMENT
  LIKE
  SUBSCRIPTION_RENEWAL
  EARNINGS_UPDATE
  VIDEO_APPROVED
  VIDEO_PROCESSED
}

// =======================
// Users
// =======================
model User {
  id             String      @id @default(cuid())
  walletAddress  String      @unique
  username       String      @unique
  email          String?     @unique
  avatar         String?
  bio            String?
  isVerified     Boolean     @default(false)
  socialLinks    Json?
  subscriberCount Int        @default(0)
  totalEarnings   Float      @default(0)
  totalViews      Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  views           View[] 

  videos         Video[]
  subscriptions  Subscription[] @relation("SubscriberSubscriptions")
  subscribers    Subscription[] @relation("CreatorSubscriptions")
  tipsGiven      Tip[] @relation("TipGiver")
  tipsReceived   Tip[] @relation("TipReceiver")
  comments       Comment[]
  likes          Like[]
  notifications  Notification[]
  videoPurchases VideoPurchase[]
  watchHistories WatchHistory[]
  earnings       Earning[]

  @@map("users")
  @@index([walletAddress])
  @@index([subscriberCount])
}

// =======================
// Video
// =======================
model Video {
  id             String      @id @default(cuid())
  title          String
  description    String?
  thumbnailUrl   String?
  thumbnailPath  String?
  autoThumbnail  String?
  thumbnailStatus ThumbnailStatus @default(PENDING)
  videoUrl       String
  videoId        String      @unique
  playbackUrl    String?
  status         VideoStatus @default(PROCESSING)
  duration       Int?
  fileSize       BigInt?
  mimeType       String?
  resolution     String?
  bitrate        Int?
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  tags           String[]
  isPublic       Boolean     @default(true)
  isPremium      Boolean     @default(false)
  price          Float?
  accessType     AccessType  @default(FREE)
  unlockPrice    Float?
  viewCount      Int         @default(0)
  likeCount      Int         @default(0)
  tipCount       Int         @default(0)
  totalEarnings  Float       @default(0)
  contractAddress String?
  transactionHash String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  publishedAt    DateTime?
  blockNumber    Int?
  videoHash      String?     @unique

  contractAddress String?
transactionHash String?


  creator        User        @relation(fields: [creatorId], references: [id])
  creatorId      String

  comments       Comment[]
  likes          Like[]
  tips           Tip[]
  views          View[]
  purchases      VideoPurchase[]
  earnings       Earning[]
  watchHistories WatchHistory[]

  @@map("videos")
  @@index([creatorId])
  @@index([categoryId])
  @@index([isPremium])
  @@index([createdAt])
  @@index([viewCount])
}

// =======================
// Enums
// =======================
enum VideoStatus {
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ThumbnailStatus {
  PENDING
  UPLOADED
  GENERATED
  FAILED
}

enum AccessType {
  FREE
  SUBSCRIPTION
  PAY_PER_VIEW
  PREMIUM
}

// =======================
// Subscriptions
// =======================
model Subscription {
  id             String            @id @default(cuid())
  tier           SubscriptionTier  @default(BASIC)
  amount         Float
  isActive       Boolean           @default(true)
  contractAddress String?
  txHash         String?
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  subscriber     User @relation("SubscriberSubscriptions", fields: [subscriberId], references: [id])
  subscriberId   String
  creator        User @relation("CreatorSubscriptions", fields: [creatorId], references: [id])
  creatorId      String

  @@unique([subscriberId, creatorId])
  @@map("subscriptions")
  @@index([subscriberId])
  @@index([creatorId])
  @@index([expiresAt])
  @@index([isActive])
}

enum SubscriptionTier {
  BASIC
  PREMIUM
  VIP
}

// =======================
// Tip/Donation
// =======================
model Tip {
  id             String   @id @default(cuid())
  amount         Float
  message        String?
  txHash         String
  contractAddress String?
  createdAt      DateTime @default(now())

  fromUser       User     @relation("TipGiver", fields: [fromUserId], references: [id])
  fromUserId     String
  toUser         User     @relation("TipReceiver", fields: [toUserId], references: [id])
  toUserId       String
  video          Video?   @relation(fields: [videoId], references: [id])
  videoId        String?
}

// =======================
// Video Purchases
// =======================
model VideoPurchase {
  id             String   @id @default(cuid())
  amount         Float
  txHash         String
  contractAddress String?
  createdAt      DateTime @default(now())

  video          Video    @relation(fields: [videoId], references: [id])
  videoId        String
  user           User     @relation(fields: [userId], references: [id])
  userId         String

  @@unique([videoId, userId])
}

// =======================
// Comments
// =======================
model Comment {
  id        String   @id @default(cuid())
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  video     Video    @relation(fields: [videoId], references: [id])
  videoId   String
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  parentId  String?
  replies   Comment[] @relation("CommentReplies")
  likes     Like[]
}

// =======================
// Likes
// =======================
model Like {
  id        String   @id @default(cuid())
  type      LikeType @default(LIKE)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  video     Video?   @relation(fields: [videoId], references: [id])
  videoId   String?
  comment   Comment? @relation(fields: [commentId], references: [id])
  commentId String?
}

enum LikeType {
  LIKE
  DISLIKE
}

// =======================
// Views
// =======================
model View {
  id        String   @id @default(cuid())
  duration  Int?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id])
  videoId   String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([videoId, userId]) // one view per logged-in user
  @@unique([videoId, ipAddress, userAgent]) // one view per anonymous user
}


// =======================
// Earning
// =======================
model Earning {
  id        String   @id @default(cuid())
  amount    Float
  type      EarningType
  txHash    String?
  earnedAt  DateTime @default(now())
  paidAt    DateTime?

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  video     Video?   @relation(fields: [videoId], references: [id])
  videoId   String?
}

enum EarningType {
  VIDEO_SALE
  TIP
  SUBSCRIPTION
  ROYALTY
  REFERRAL
}

// =======================
// Watch History
// =======================
model WatchHistory {
  id        String   @id @default(cuid())
  progress  Float
  duration  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  userId    String
  video     Video    @relation(fields: [videoId], references: [id])
  videoId   String
}

// =======================
// Categories
// =======================
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  videos      Video[]
}

