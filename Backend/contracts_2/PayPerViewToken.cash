pragma cashscript ^0.12.0;

contract PayPerViewToken(
    pubkey creator,       // Creator's public key
    bytes32 videoIdHash,  // Hash representing the video
    int priceSats         // Minimum price to unlock
) {

    /**
     * Withdraw function
     * Creator can withdraw funds after payment
     * @param s Signature of the creator
     * @param totalFunds Total amount sent to the contract
     */
    function withdraw(sig s, int totalFunds) {
        // Verify creator's signature
        require(checkSig(s, creator));

        // Ensure funds sent are >= required price
        require(totalFunds >= priceSats);
    }

    /**
     * Watch function
     * Viewer must provide correct video ID hash to unlock
     * @param id Hash of the video
     */
    function watch(bytes32 id) {
        // Verify correct video
        require(id == videoIdHash);

        // Payment verification happens in the backend via `txHash`
        // This function doesn't move funds, only gates access
    }
}
