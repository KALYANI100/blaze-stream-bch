pragma cashscript ^0.12.0;

contract PayPerViewToken(
    pubkey creatorPubkey,
    int price,
    bytes20 creatorPkh
) {
    function pay(sig viewerSig) {
        // Ensure payment meets the price
        require(tx.outputs[0].value >= price);

        // Ensure the first output sends to the creator using correct P2PKH syntax
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(creatorPkh));

        // Ensure viewer provides valid signature
        require(checkSig(viewerSig, creatorPubkey));
    }
}