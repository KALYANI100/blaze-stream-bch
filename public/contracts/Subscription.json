  "source": "pragma cashscript ^0.12.0;\r\n\r\ncontract Subscription(pubkey creator, int unlockBlock) {\r\n    function subscribe(sig creatorSig) {\r\n        require(tx.time >= unlockBlock);    // time or block height check\r\n        require(checkSig(creatorSig, creator));\r\n    }\r\n}\r\n",
